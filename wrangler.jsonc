{
  // Cloudflare Workers static-assets deployment. The demo needs no server code:
  // every page is served from ./dist, and unknown paths fall back to index.html
  // so the app can show its own pages (including "Page not found").
  "name": "waypoint-flights",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
